{
  "manifest_version": 3,
  "name": "Steam Currency Converter",
  "version": "1.0.0",
  "description": "Widget for converting price in client Steam",
  "permissions": ["storage"],
  "host_permissions": ["https://open.er-api.com/*"],
  "content_scripts": [
    {
      "matches": [
        "https://store.steampowered.com/*",
        "https://steamcommunity.com/*"
      ],
      "css": ["style.css"],
      "js": ["script.js"],
      "run_at": "document_end"
    }
  ]
}
